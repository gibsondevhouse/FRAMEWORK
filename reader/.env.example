# Copy this file to reader/.env. Both settings are optional: reading and search
# work without them; only the Claude assistant needs a key.

# Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Preferred model id. Leave empty to use the first sonnet/opus/haiku model the
# key can see (GET /api/models lists them).
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OSHA news (the #/news page) -------------------------------------------
# All four settings are optional. Federal Register news needs no credentials.

# Free DOL Open Data API key for OSHA enforcement data (inspections, violations,
# penalties). Register at https://dataportal.dol.gov/registration. Without it the
# Enforcement tab shows setup instructions; everything else works.
DOL_API_KEY=

# Federal Register agency slugs to follow, comma-separated. Only OSHA is
# supported in this version.
NEWS_AGENCIES=occupational-safety-and-health-administration

# Set to 0 to turn the background news sync off.
NEWS_SYNC=1

# How many days of news to keep (also the first sync's Federal Register
# backfill window).
NEWS_RETENTION_DAYS=365

# --- Federal Register corpus (python -m app.fr_build) -----------------------
# Optional. The corpus collects FR documents that cite a CFR title, going back
# FR_CORPUS_YEARS years (default 5). FR_CORPUS_TITLES is comma-separated; when
# unset the corpus follows the installed CFR titles.
# FR_CORPUS_TITLES=29,40,49
# FR_CORPUS_YEARS=5
# Minimum seconds between Federal Register API requests (default 1). Raise it if
# federalregister.gov answers 429; builds also retry and can be resumed.
# FR_MIN_INTERVAL=1

# --- Integrity (python -m app.integrity) -------------------------------------
# Optional api.data.gov key for the GovInfo cross-check of Federal Register
# documents. Without it that check is skipped with an INFO line.
# GOVINFO_API_KEY=
